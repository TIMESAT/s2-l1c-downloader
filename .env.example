# Copy this file to .env for your own reference, then export the values in your
# shell. The application deliberately does not read or persist .env files.
CDSE_USERNAME=
CDSE_PASSWORD=

# Optional: required only when your CDSE account has time-based 2FA enabled.
CDSE_TOTP=

# Optional alternative for short-lived/manual sessions. If set, username and
# password are not used until the token expires or CDSE returns HTTP 401.
CDSE_ACCESS_TOKEN=

# Optional non-secret archive location override. Useful on Linux/HPC storage.
S2VOMB_DOWNLOAD_DIRECTORY=
